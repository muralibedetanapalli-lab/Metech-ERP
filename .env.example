# ───────── Core ─────────
DATABASE_URL=postgresql://postgres@localhost:5433/metech_erp
# Used only by tests (migrated + truncated)
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/metech_erp_test
APP_URL=http://localhost:3100
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_TTL_HOURS=72

# ───────── Dukaan Express integration ─────────
# Base URL of the Dukaan Express app (API + admin panel), e.g. http://localhost:3000 or https://dukaanexpress.in
DUKAAN_BASE_URL=http://localhost:3000
# Service key shared with Dukaan (same value as ERP_API_KEY in Dukaan's environment). Blank → sync disabled.
DUKAAN_API_KEY=
# Bearer token for POST /api/integrations/dukaan/sync (scheduled sync from a cron job). Blank → only manual sync.
CRON_SECRET=

DB_POOL_MAX=5
