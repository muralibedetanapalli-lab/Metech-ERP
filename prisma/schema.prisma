// Metech ERP — accounting, ERP and CRM for Metech Solutions.
// Money is always integer paise. Tax rates are basis points (18% = 1800 bps).
// Every accounting document posts a balanced JournalEntry; reports read only journal lines.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity ─────────────────────────────

enum UserRole {
  OWNER // everything, including users and settings
  ACCOUNTANT // accounting + ERP, read CRM
  SALES // CRM, read-only accounting
  VIEWER // read-only everywhere
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           UserRole
  active         Boolean   @default(true)
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ownedDeals      Deal[]     @relation("DealOwner")
  activities      Activity[] @relation("ActivityAssignee")
  createdEntries  JournalEntry[]
  auditLogs       AuditLog[]
}

/// Single-row company profile and integration settings (id = "company").
model CompanySettings {
  id                   String   @id @default("company")
  name                 String   @default("Metech Solutions")
  legalName            String?
  gstin                String?
  pan                  String?
  stateCode            String   @default("36") // GST state code of the registered office (36 = Telangana)
  address              String?
  email                String?
  phone                String?
  fyStartMonth         Int      @default(4) // April
  invoicePrefix        String   @default("MS")
  /// Optional GST on Dukaan platform commission, in bps (0 = book commission as-is).
  commissionGstBps     Int      @default(0)
  /// Bank/cash account used for Dukaan payouts (shop settlements, dealer and rider payouts).
  dukaanPayoutAccountId String?
  updatedAt            DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────────────────── Parties (CRM contacts & companies, customers, vendors) ─────────────────────────────

enum PartyKind {
  ORGANIZATION
  PERSON
}

/// Anyone Metech deals with. Organisations ("companies") and people ("contacts") share one table so that
/// invoices, payments, ledgers and CRM all point at the same record.
model Party {
  id           String    @id @default(cuid())
  kind         PartyKind
  name         String
  displayName  String?
  email        String?
  phone        String?
  gstin        String?
  pan          String?
  stateCode    String? // GST state code; drives CGST+SGST vs IGST
  address      String?
  city         String?
  pincode      String?
  isCustomer   Boolean   @default(false)
  isVendor     Boolean   @default(false)
  tags         String[]
  notes        String?
  /// A contact person can belong to an organisation.
  orgId        String?
  org          Party?    @relation("OrgMembers", fields: [orgId], references: [id], onDelete: SetNull)
  members      Party[]   @relation("OrgMembers")
  /// Link to a Dukaan Express record (source "DUKAAN", type SHOP | SHOP_OWNER | DEALER | RIDER | CUSTOMER).
  extSource    String?
  extType      String?
  extId        String?
  extData      Json?
  extSyncedAt  DateTime?
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deals        Deal[]
  activities   Activity[]
  invoices     Invoice[]
  payments     Payment[]
  journalLines JournalLine[]
  expenses     Expense[]

  @@unique([extSource, extType, extId])
  @@index([kind, archived])
  @@index([name])
}

// ───────────────────────────── CRM ─────────────────────────────

model PipelineStage {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int
  /// OPEN stages are the pipeline; WON / LOST close the deal.
  outcome   String  @default("OPEN") // OPEN | WON | LOST
  isLead    Boolean @default(false) // early stages shown on the Leads screen
  deals     Deal[]
}

model Deal {
  id            String        @id @default(cuid())
  title         String
  partyId       String?
  party         Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  stageId       String
  stage         PipelineStage @relation(fields: [stageId], references: [id])
  value         Int           @default(0)
  source        String? // website, referral, Dukaan, call…
  expectedClose DateTime?
  ownerId       String?
  owner         User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  closedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  activities Activity[]

  @@index([stageId])
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  TASK
  FOLLOW_UP
}

/// Notes, calls, meetings, tasks and follow-up reminders. A reminder is any activity with dueAt and no doneAt.
model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  subject    String
  body       String?
  partyId    String?
  party      Party?       @relation(fields: [partyId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?        @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueAt      DateTime?
  doneAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([dueAt, doneAt])
  @@index([partyId])
  @@index([dealId])
}

// ───────────────────────────── Accounting ─────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  /// BANK | CASH | RECEIVABLE | PAYABLE | TAX | INVENTORY | FIXED_ASSET | CLEARING …
  subtype   String?
  /// Stable key for accounts the app posts to automatically (e.g. "DUKAAN_SHOP_PAYABLE").
  systemKey String?     @unique
  parentId  String?
  parent    Account?    @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Account[]   @relation("AccountTree")
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  lines           JournalLine[]
  statementLines  BankStatementLine[]
  invoiceLines    InvoiceLine[]
  paymentsViaBank Payment[]
  expenses        Expense[]           @relation("ExpenseAccount")
  expensesPaid    Expense[]           @relation("ExpensePaidFrom")

  @@index([type])
}

model CostCentre {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  kind      String   @default("PROJECT") // PROJECT | DEPARTMENT | BRANCH
  active    Boolean  @default(true)
  budget    Int?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())

  lines JournalLine[]
}

enum EntrySource {
  MANUAL
  SALES_INVOICE
  PURCHASE_INVOICE
  RECEIPT
  PAYMENT
  EXPENSE
  DUKAAN
  OPENING
}

model JournalEntry {
  id          String      @id @default(cuid())
  number      String      @unique
  date        DateTime
  narration   String
  source      EntrySource @default(MANUAL)
  /// Idempotency key for automatic postings, e.g. "dukaan:order.delivered:<orderId>".
  sourceRef   String?     @unique
  voided      Boolean     @default(false)
  voidReason  String?
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  lines JournalLine[]

  @@index([date])
  @@index([source, date])
}

model JournalLine {
  id           String       @id @default(cuid())
  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id])
  debit        Int          @default(0)
  credit       Int          @default(0)
  partyId      String?
  party        Party?       @relation(fields: [partyId], references: [id], onDelete: SetNull)
  costCentreId String?
  costCentre   CostCentre?  @relation(fields: [costCentreId], references: [id], onDelete: SetNull)
  memo         String?

  reconciledWith BankStatementLine?

  @@index([accountId])
  @@index([partyId])
  @@index([entryId])
}

model Sequence {
  key  String @id // e.g. "JV-2026", "INV-2026"
  next Int    @default(1)
}

enum InvoiceKind {
  SALES
  PURCHASE
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIAL
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  kind           InvoiceKind
  number         String
  partyId        String
  party          Party         @relation(fields: [partyId], references: [id])
  date           DateTime
  dueDate        DateTime?
  placeOfSupply  String // GST state code
  status         InvoiceStatus @default(DRAFT)
  taxableAmount  Int           @default(0)
  cgst           Int           @default(0)
  sgst           Int           @default(0)
  igst           Int           @default(0)
  total          Int           @default(0)
  amountPaid     Int           @default(0)
  notes          String?
  vendorRef      String? // supplier's bill number for purchases
  journalEntryId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([kind, number])
  @@index([partyId])
  @@index([status, date])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description String
  hsnSac      String?
  quantity    Float   @default(1)
  rate        Int // paise per unit, before tax
  discount    Int     @default(0)
  taxRateBps  Int     @default(0)
  taxable     Int     @default(0)
  cgst        Int     @default(0)
  sgst        Int     @default(0)
  igst        Int     @default(0)
  amount      Int     @default(0) // taxable + tax
  accountId   String // income (sales) or expense/asset (purchase) account
  account     Account @relation(fields: [accountId], references: [id])
  sortOrder   Int     @default(0)
}

enum PaymentKind {
  RECEIPT // money in
  PAYMENT // money out
}

model Payment {
  id             String      @id @default(cuid())
  kind           PaymentKind
  number         String      @unique
  date           DateTime
  partyId        String?
  party          Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)
  amount         Int
  bankAccountId  String
  bankAccount    Account     @relation(fields: [bankAccountId], references: [id])
  mode           String      @default("BANK") // BANK | UPI | CASH | CHEQUE | CARD
  reference      String?
  notes          String?
  journalEntryId String?     @unique
  createdAt      DateTime    @default(now())

  allocations PaymentAllocation[]

  @@index([partyId])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Int

  @@unique([paymentId, invoiceId])
}

model Expense {
  id             String      @id @default(cuid())
  date           DateTime
  accountId      String
  account        Account     @relation("ExpenseAccount", fields: [accountId], references: [id])
  paidFromId     String
  paidFrom       Account     @relation("ExpensePaidFrom", fields: [paidFromId], references: [id])
  partyId        String?
  party          Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)
  costCentreId   String?
  amount         Int // before GST
  gstRateBps     Int         @default(0)
  gstAmount      Int         @default(0)
  interState     Boolean     @default(false)
  description    String
  reference      String?
  journalEntryId String?     @unique
  createdAt      DateTime    @default(now())
}

/// Imported bank statement row; reconciled by matching it to a journal line on the same bank account.
model BankStatementLine {
  id            String       @id @default(cuid())
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id])
  date          DateTime
  description   String
  reference     String?
  amount        Int // signed: + deposit, − withdrawal
  journalLineId String?      @unique
  journalLine   JournalLine? @relation(fields: [journalLineId], references: [id], onDelete: SetNull)
  importBatch   String?
  createdAt     DateTime     @default(now())

  @@index([accountId, date])
}

// ───────────────────────────── ERP ─────────────────────────────

model Item {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  kind         String   @default("GOODS") // GOODS | SERVICE
  hsnSac       String?
  unit         String   @default("nos")
  salePrice    Int      @default(0)
  purchasePrice Int     @default(0)
  taxRateBps   Int      @default(1800)
  trackStock   Boolean  @default(true)
  stock        Float    @default(0)
  reorderLevel Float    @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoiceLines InvoiceLine[]
  movements    StockMovement[]
}

model StockMovement {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  quantity  Float // + in, − out
  reason    String // PURCHASE | SALE | ADJUSTMENT | OPENING
  reference String?
  createdAt DateTime @default(now())

  @@index([itemId, date])
}

model Asset {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  category       String // LAPTOP, FURNITURE, VEHICLE …
  purchaseDate   DateTime
  cost           Int
  usefulLifeMonths Int     @default(36)
  salvageValue   Int       @default(0)
  location       String?
  assignedTo     String?
  disposedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
}

model Employee {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  email         String?
  phone         String?
  designation   String?
  department    String?
  joinDate      DateTime
  exitDate      DateTime?
  pan           String?
  monthlyCtc    Int       @default(0)
  basic         Int       @default(0)
  hra           Int       @default(0)
  otherAllow    Int       @default(0)
  pfApplicable  Boolean   @default(true)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  payslips Payslip[]
}

model Payslip {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period      String // "2026-11"
  gross       Int
  pfEmployee  Int      @default(0)
  professionalTax Int  @default(0)
  tds         Int      @default(0)
  net         Int
  journalEntryId String? @unique
  createdAt   DateTime @default(now())

  @@unique([employeeId, period])
}

// ───────────────────────────── Dukaan Express integration ─────────────────────────────

/// Cursor per Dukaan feed ("parties", "events") so each sync pulls only what changed.
model SyncCursor {
  feed      String   @id
  cursor    String?
  updatedAt DateTime @updatedAt
}

model SyncRun {
  id         String    @id @default(cuid())
  trigger    String // MANUAL | CRON | WEBHOOK | CLI
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  parties    Int       @default(0)
  events     Int       @default(0)
  posted     Int       @default(0)
  skipped    Int       @default(0)
  error      String?
}
